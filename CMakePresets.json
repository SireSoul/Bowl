{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "dev",
      "displayName": "Dev (debuggable, optimized, dev tools + hot reload)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "BOWL_DEV_TOOLS": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BOWL_DEV_TOOLS": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release (shipping: no dev tools, precompiled shaders, static SDL, macOS .app bundles)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOWL_DEV_TOOLS": "OFF",
        "BOWL_FETCH_SDL": "ON",
        "BOWL_MACOS_BUNDLES": "ON",
        "BOWL_PACK_ASSETS": "ON"
      }
    },
    {
      "name": "host-tools",
      "displayName": "Host tools (bowl-shaderc, bowl-icon, bowl-pack for cross builds, in build/host-tools/bin)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOWL_DEV_TOOLS": "OFF",
        "BOWL_BUILD_TESTS": "OFF",
        "BOWL_BUILD_SAMPLES": "OFF",
        "BOWL_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS and iPadOS (Xcode project; build host-tools first)",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "BOWL_DEV_TOOLS": "OFF",
        "BOWL_FETCH_SDL": "ON",
        "BOWL_BUILD_TESTS": "OFF",
        "BOWL_BUILD_EDITOR": "OFF",
        "BOWL_PACK_ASSETS": "ON",
        "BOWL_HOST_TOOLS": "${sourceDir}/build/host-tools/bin"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "RelWithDebInfo" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "host-tools", "configurePreset": "host-tools", "configuration": "Release",
      "targets": ["bowl-shaderc", "bowl-icon", "bowl-pack"] },
    { "name": "ios-simulator", "configurePreset": "ios", "configuration": "Release",
      "nativeToolOptions": ["-sdk", "iphonesimulator", "-arch", "arm64"] },
    { "name": "ios-device", "configurePreset": "ios", "configuration": "Release",
      "nativeToolOptions": ["-sdk", "iphoneos"] }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
